--------------------------------------------------
-- ESTADO DAS TECLAS
--------------------------------------------------

local teclasPressionadas = {}

local function pressionarTecla(codigo)
	if typeof(keypress) ~= "function" then
		return
	end

	if teclasPressionadas[codigo] then
		return
	end

	teclasPressionadas[codigo] = true

	pcall(function()
		keypress(codigo)
	end)
end

local function soltarTecla(codigo)
	if not teclasPressionadas[codigo] then
		return
	end

	teclasPressionadas[codigo] = nil

	if typeof(keyrelease) == "function" then
		pcall(function()
			keyrelease(codigo)
		end)
	end
end

local function soltarTodasAsTeclas()
	for codigo in pairs(teclasPressionadas) do
		if typeof(keyrelease) == "function" then
			pcall(function()
				keyrelease(codigo)
			end)
		end
	end

	teclasPressionadas = {}
end

--------------------------------------------------
-- POSIÇÃO
--------------------------------------------------

local function aplicarPos(obj, nome, padrao)
	if saved[nome] then
		obj.Position = saved[nome]
	else
		obj.Position = padrao
	end
end

--------------------------------------------------
-- ARRASTAR
--------------------------------------------------

local function arrastavel(obj, nome)

	local dragging = false
	local dragStart
	local startPos

	obj.InputBegan:Connect(function(input)

		if not editando then
			return
		end

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			dragging = true
			dragStart = input.Position
			startPos = obj.Position

			input.Changed:Connect(function()

				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					saved[nome] = obj.Position
				end

			end)

		end

	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging or not editando then
			return
		end

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

			local delta = input.Position - dragStart

			obj.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)

		end

	end)

end

