--------------------------------------------------

local function criarDPad(nome, texto, pos, teclas)

	local b = Instance.new("TextButton")

	b.Name = nome
	b.Size = UDim2.new(0,40,0,40)
	b.Position = pos

	b.Text = texto
	b.TextSize = 21

	b.BackgroundColor3 = Color3.fromRGB(30,30,30)
	b.BackgroundTransparency = 0.15

	b.BorderSizePixel = 1
	b.BorderColor3 = Color3.fromRGB(100,100,100)

	b.TextColor3 = Color3.new(1,1,1)

	b.Active = true
	b.Parent = dpad

	local pressionado = false

	local function ligar()
		if editando or pressionado then
			return
		end

		pressionado = true

		-- Pressiona todas as teclas da direção
		for _, codigo in ipairs(teclas) do
			pressionarTecla(codigo)
		end
	end

	local function desligar()
		if not pressionado then
			return
		end

		pressionado = false

		-- Solta todas as teclas da direção
		for _, codigo in ipairs(teclas) do
			soltarTecla(codigo)
		end
	end

	b.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			ligar()

		end

	end)

	b.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			desligar()

		end

	end)

	b.MouseEnter:Connect(function()

		if UserInputService.TouchEnabled then
			return
		end

		ligar()

	end)

	b.MouseLeave:Connect(function()

		if not UserInputService.TouchEnabled then
			desligar()
		end

	end)

	return b
end

